<Window x:Class="FocusOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Focus Overlay"
        Width="276"
        Height="164"
        MinWidth="276"
        MinHeight="164"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        Topmost="True"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="#D9D7D1"
            BorderThickness="1"
            CornerRadius="16">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Focus" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Ellipse x:Name="ModeDot" Grid.Column="1" Width="7" Height="7"
                         Margin="8,1,0,0" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>

                <Button x:Name="ModeButton" Grid.Column="3" Style="{StaticResource IconButton}"
                        Width="28" Height="28" Content="⊘" FontSize="15"
                        AutomationProperties.Name="Не мешать"
                        ToolTip="Не мешать — карточки останутся видимыми и начнут пропускать клики"
                        Click="Focus_Click"/>
                <Button x:Name="HelpButton" Grid.Column="4" Style="{StaticResource IconButton}"
                        Width="28" Height="28" Content="?" FontSize="13" FontWeight="SemiBold"
                        AutomationProperties.Name="Справка" ToolTip="Справка"
                        Click="Help_Click"/>
                <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="—"
                        Width="28" Height="28" AutomationProperties.Name="Скрыть"
                        ToolTip="Скрыть в трей" Click="Hide_Click"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Margin="0,0,4,0"
                        AutomationProperties.Name="Создать задачу" ToolTip="Задача"
                        Click="Task_Click">
                    <TextBlock Text="✓" FontSize="20" FontWeight="SemiBold"
                               Foreground="#697BE8" HorizontalAlignment="Center"/>
                </Button>
                <Button Grid.Column="1" Margin="2,0"
                        AutomationProperties.Name="Создать заметку" ToolTip="Заметка"
                        Click="Note_Click">
                    <TextBlock Text="✎" FontSize="19" Foreground="#49A984" HorizontalAlignment="Center"/>
                </Button>
                <Button x:Name="CreateImageButton" Grid.Column="2" Margin="4,0,0,0"
                        AutomationProperties.Name="Создать изображение" ToolTip="Изображение"
                        Click="Image_Click">
                    <TextBlock Text="▧" FontSize="19" Foreground="#D69148" HorizontalAlignment="Center"/>
                </Button>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="◇" FontSize="10" Foreground="#969993" VerticalAlignment="Center"/>
                <TextBlock x:Name="CardCount" Grid.Column="1" Text="0" Margin="5,0,0,0"
                           FontSize="11" Foreground="#777A73" VerticalAlignment="Center"/>
                <Button x:Name="ExitButton" Grid.Column="2" Content="×" Width="24" Height="24" Padding="0"
                        Style="{StaticResource IconButton}" Foreground="#A3A49F"
                        AutomationProperties.Name="Выйти" ToolTip="Выйти"
                        Click="Exit_Click"/>
            </Grid>

            <TextBlock x:Name="Warning" Grid.Row="3" Margin="0,5,0,0"
                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       FontSize="10" Visibility="Collapsed"/>

            <Popup x:Name="HelpPopup"
                   PlacementTarget="{Binding ElementName=HelpButton}"
                   Placement="Bottom"
                   HorizontalOffset="-236"
                   VerticalOffset="8"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="False">
                <Border Width="276" Padding="16" CornerRadius="14"
                        Background="#FCFBF8" BorderBrush="#D9D7D1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Справка" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="✓" Foreground="#697BE8" FontSize="16"/>
                            <TextBlock Grid.Column="1" Text="Задача" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="✎" Foreground="#49A984" FontSize="15"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Заметка" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="▧" Foreground="#D69148" FontSize="15"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Изображение" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="#E2E0DA" Margin="0,9"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="●" Foreground="#697BE8" FontSize="14"/>
                            <TextBlock Grid.Column="1" Text="Потянуть связь" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="⌁" Foreground="#777A73" FontSize="15"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Подпись, цвет и стрелки" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="#E2E0DA" Margin="0,9"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>
                            <Ellipse Width="7" Height="7" Fill="#8B9DFF" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Карточки доступны" FontSize="12" VerticalAlignment="Center"/>
                            <Ellipse Grid.Row="1" Width="7" Height="7" Fill="#D89A52" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Клики проходят сквозь" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="#E2E0DA" Margin="0,9"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Не мешать / вернуть" FontSize="11" Foreground="#777A73" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Ctrl  Shift  F" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="Карточка из буфера" FontSize="11" Foreground="#777A73" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl  Shift  Space" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="Вставить в референс" FontSize="11" Foreground="#777A73" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Ctrl  V / drop" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Text="На всю карточку" FontSize="11" Foreground="#777A73" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="⛶" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
